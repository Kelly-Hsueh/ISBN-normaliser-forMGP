# 公共配置 — 纳入版本控制，随仓库分发
# 密钥（BOT_USERNAME、BOT_PASSWORD）请在 .env.pwd 中配置，不要写在此文件

WIKI_API=https://mzh.moegirl.org.cn/api.php
USER_AGENT=ISBNNormaliser-Bot/1.1 (https://github.com/Kelly-Hsueh/ISBN-normaliser-forMGP; 75931686+Kelly-Hsueh@users.noreply.github.com) requests/2.33.x
TEMPLATE_TITLE=Template:ISBN|Template:ISBNT|Template:Cite book
DEFAULT_QUERY=booksource-search
XML_PATH=RangeMessage.xml
REHYPHENATE_EQUAL_LABEL=false
TO13=false
SUMMARY=根据 ISO 2108:2017（https://www.iso.org/standard/65483.html ）自动调整ISBN（若阁下对此次修改感到疑惑，可以前往 https://grp.isbn-international.org/ 查找出版社前缀信息）
EDIT_TAGS=Bot
UPDATE_STATUS_PAGE=true